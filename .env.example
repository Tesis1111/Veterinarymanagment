# ============================================================
# Veterinaria Leo — Variables de entorno
# ============================================================
#
# 1. Copiar este archivo a ".env" para desarrollo local.
# 2. En Vercel: Settings → Environment Variables → agregar cada clave.
#
# Las variables con prefijo VITE_ se incluyen en el bundle del navegador;
# el resto sólo las leen las funciones serverless de api/.
# ============================================================

# ── Firebase Web SDK (obligatorias) ────────────────────────────────────────
#
# Sin estas la aplicación no arranca. Se obtienen en:
#   Consola Firebase → Configuración del proyecto → Tus apps → Web
#
# Se incluyen en el bundle del cliente: son públicas por diseño. La seguridad
# real la dan firestore.rules + Firebase Auth, no el secreto de estas claves.
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXXXXXXXXXXXX

# ── Envío de correo (/api/send-email) ──────────────────────────────────────

# API key de Resend. La lee la función serverless desde process.env, así que
# no lleva prefijo VITE_ y nunca llega al navegador.
RESEND_API_KEY=re_ejemplo123456789

# Opcional: Correo desde donde se envían (Debe ser un dominio verificado en Resend)
# Por defecto el código usa: Veterinaria Leo <notificaciones@notificationvet.com>
EMAIL_FROM="Veterinaria Leo <notificaciones@notificationvet.com>"

# ── Recuperación de contraseña (/api/password-recovery) ────────────────────

# OBLIGATORIA. Service account de Firebase en base64.
#
# La necesita el Admin SDK, y sin ella el endpoint devuelve 500. Es lo que
# permite auditar la solicitud: quien recupera su contraseña no tiene sesión,
# así que las reglas de Firestore rechazan toda escritura desde el navegador.
# El Admin SDK no pasa por las reglas y puede dejar el registro sin que haya
# que aflojar ninguna.
#
# Cómo obtenerla:
#   Consola Firebase → Configuración del proyecto → Cuentas de servicio →
#   Generar nueva clave privada
#   base64 -w0 serviceAccountKey.json
#
# Se guarda en base64 (y no como JSON crudo) porque la clave privada contiene
# saltos de línea que los paneles de variables de entorno suelen mutilar.
# ⚠️ NUNCA commitear el archivo original: da acceso total al proyecto.
FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# URL pública de la app, para el enlace de regreso tras restablecer la
# contraseña. Si no se define se deduce de la cabecera Host del pedido.
# El dominio debe estar en Firebase → Authentication → Settings → Dominios
# autorizados, o generatePasswordResetLink() lo rechaza.
APP_URL=https://veterinarialeo.vercel.app

# OPCIONAL. Destinatario ADICIONAL de los avisos de seguridad.
#
# Los destinatarios habituales se consultan en /usuarios (roleName == 'admin'
# y active == true). Esta variable solo AGREGA una casilla fija; ya no
# reemplaza a los administradores reales ni tiene un valor por defecto: si no
# hay ningún destinatario, se registra un error de configuración en los logs
# en lugar de mandar los avisos a una casilla de pruebas.
ADMIN_NOTIFICATION_EMAIL=admin@veterinarialeo.com
